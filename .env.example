# Database Configuration
DATABASE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
DATABASE_PATH=clinic.db

# Application Settings
APP_ORIGIN=http://localhost:8000
ALLOWED_ORIGINS=https://your-app.vercel.app
CLINIC_TIMEZONE=America/New_York
COOKIE_SECURE=false
SESSION_SECRET=a-secure-random-32-character-secret-key-for-sessions

# Demo Account Passwords (12+ characters)
DOCTOR1_PASSWORD=
DOCTOR2_PASSWORD=
RECEPTION_PASSWORD=
ADMIN_PASSWORD=

# WhatsApp Integration (Mock mode active while Meta registration is pending)
MOCK_WHATSAPP=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=clinic_followup
WHATSAPP_GRAPH_VERSION=v23.0
